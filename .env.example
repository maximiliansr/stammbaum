# Kopieren nach .env und anpassen

# Passwort für alle Familienmitglieder (lesen + Änderungen vorschlagen)
FAMILY_PASSWORD=bitte-aendern-familie

# Passwort für die Verwaltung (direkt bearbeiten, Vorschläge freigeben)
ADMIN_PASSWORD=bitte-aendern-admin-lang-und-geheim

# Ihre Domain für HTTPS (nur für docker-compose mit Caddy)
DOMAIN=stammbaum.example.de

# Optional: Titel überschreiben (sonst aus den Daten)
# SITE_TITLE=Stammbaum Familie Muster

# Sollen Familienmitglieder Straße/PLZ sehen? (Admins sehen immer alles)
FAMILY_SEES_ADDRESSES=true

# Wie viele tägliche Sicherungen behalten
BACKUP_DAYS=90

# Beim allerersten Start erfundene Beispielfamilie laden (true) oder leer starten (false)
BEISPIELDATEN=true

# Zeitzone (für Sicherungs-Uhrzeit und Protokoll)
TZ=Europe/Berlin

# Öffentliche Adresse (für Links in Benachrichtigungen)
# PUBLIC_URL=https://stammbaum.example.de

# Benachrichtigungen über ntfy (alles auch in Verwaltung → Einstellungen änderbar)
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=stammbaum-familie-x7k2
# NTFY_TOKEN=

# Externe Sicherung (alles auch in Verwaltung → Einstellungen änderbar)
# BACKUP_TARGET=ordner        # ordner | webdav | s3
# BACKUP_TIME=03:30
# BACKUP_KEEP=30
# BACKUP_DIR=/backup
# BACKUP_WEBDAV_URL=https://cloud.example.de/remote.php/dav/files/max/Backups/Stammbaum/
# BACKUP_WEBDAV_USER=
# BACKUP_WEBDAV_PASSWORD=
# BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# BACKUP_S3_REGION=eu-central-003
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# Karte
# MAP_COUNTRIES=de,at,ch       # Ortssuche eingrenzen
# MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
